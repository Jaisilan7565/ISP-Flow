PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:2000
# PostgreSQL connection (password may also come from your pgpass file)
DATABASE_URL=postgres://postgres@localhost:5432/isp_flow
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
# First Platform Admin, created by `npm run db:setup` if no platform owner exists
PLATFORM_OWNER_NAME=Platform Admin
PLATFORM_OWNER_EMAIL=owner@ispflow.local
PLATFORM_OWNER_PASSWORD=ChangeMe@123
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
# Billing scheduler: generate due recurring cycles every N minutes (0 = off)
BILLING_SCHEDULER_MINUTES=360
# Business timezone for 'today', due dates and SLA clocks
APP_TIMEZONE=Asia/Kolkata
