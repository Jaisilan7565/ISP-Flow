# Copy to .env next to docker-compose.yml and change every value marked CHANGE.
POSTGRES_USER=ispflow
POSTGRES_PASSWORD=CHANGE-a-long-database-password
JWT_SECRET=CHANGE-a-long-random-string-at-least-32-characters
PLATFORM_OWNER_NAME=Platform Admin
PLATFORM_OWNER_EMAIL=owner@example.com
PLATFORM_OWNER_PASSWORD=CHANGE-Initial@123
# Address people use to open the app (used for CORS / live sync)
PUBLIC_URL=http://localhost:2000
WEB_PORT=2000
MAX_UPLOAD_MB=10
BILLING_SCHEDULER_MINUTES=360
LOG_LEVEL=info
